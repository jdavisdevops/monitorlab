# LM Studio API Configuration
LLM_API_BASE=http://localhost:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=local-model

# Vision Model Configuration (Qwen2-VL-4B recommended)
VISION_API_BASE=http://localhost:1234/v1
VISION_MODEL=Qwen2-VL-4B-Instruct
VISION_TEMPERATURE=0.2

# MCP Configuration
MCP_PLAYWRIGHT_ENABLED=true
MCP_PLAYWRIGHT_SERVER=stdio

# Agent Configuration
MAX_CONCURRENT_AGENTS=5
AGENT_TIMEOUT=300

# Database Configuration (for run history)
DATABASE_URL=sqlite+aiosqlite:///./monitorlab.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=monitorlab.log

# Screenshots
SCREENSHOT_DIR=./screenshots
SCREENSHOT_QUALITY=90

# Gradio Configuration
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
